{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["every weekend"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["debian"],
      "versioning": "regex:^(?<major>\\d+)-slim$"
    },
    {
      "matchDepNames": ["go"],
      "matchDatasources": ["golang-version"],
      "groupName": "Go version"
    },
    {
      "matchDepNames": ["golangci/golangci-lint"],
      "groupName": "golangci-lint"
    },
    {
      "matchDepNames": ["java-jdk"],
      "matchDatasources": ["java-version"],
      "extractVersion": "^(?<version>\\d+)"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"node\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"nvm\":\\s*\"(?<currentValue>[\\d.]+)\""],
      "depNameTemplate": "nvm-sh/nvm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"java\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"dotnet\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"go\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"docker\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "docker",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"busybox\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "busybox",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/image/tools/versions\\.json$/"],
      "matchStrings": ["\"debian\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "debian",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)-slim$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build/Dockerfile$/"],
      "matchStrings": ["ARG GO_VERSION=(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.agenticrc\\.toml$/"],
      "matchStrings": [
        "golangci-lint.run/install\\.sh \\| sh -s -- -b /usr/local/bin v(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["GOVULNCHECK_VERSION \\?= (?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["GOTESTSUM_VERSION \\?= (?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "gotest.tools/gotestsum",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/actions/setup-msb/action\\.yml$/"],
      "matchStrings": [
        "MSB_VERSION:\\s*(?<currentValue>v[\\d.]+)\\s+MSB_CHECKSUMS_SHA256:\\s*(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "superradcompany/microsandbox",
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
