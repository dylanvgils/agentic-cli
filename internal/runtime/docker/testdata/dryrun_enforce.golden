docker network \
  create \
  --internal \
  --opt=com.docker.network.bridge.inhibit_ipv4=true \
  --ipv6=false \
  --label=project=agentic-cli \
  --label=agentic.owner=agentic-claude-<id> \
  --label=agentic.started=<time> \
  agentic-run-<id>
docker create \
  --read-only \
  --name=agentic-proxy-<id> \
  --network=agentic-run-<id> \
  --network-alias=agentic-proxy \
  --cap-drop=ALL \
  --security-opt=no-new-privileges:true \
  --user=1000:1000 \
  --label=project=agentic-cli \
  --label=agentic.owner=agentic-claude-<id> \
  --label=agentic.started=<time> \
  --env=AGENTIC_PROXY_ADDR=:3128 \
  '--env=AGENTIC_PROXY_RULES=[{"host":"api.example.test"},{"host":"repo.example.test","paths":["/org/**"]}]' \
  --env=AGENTIC_PROXY_LOG=/var/log/agentic-proxy/proxy_0123456789ab.jsonl \
  --env=AGENTIC_PROXY_TZ_OFFSET=<offset> \
  --env=AGENTIC_PROXY_MONITOR=false \
  '--env=AGENTIC_PROXY_CLIENT_NETS=<proxy network subnets>' \
  --volume=<tool-home>/logs/proxy_0123456789ab.jsonl:/var/log/agentic-proxy/proxy_0123456789ab.jsonl \
  --env=AGENTIC_PROXY_CA_DIR=/run/agentic-proxy/credentials \
  --env=AGENTIC_PROXY_CREDENTIALS=/run/agentic-proxy/credentials/credentials.json \
  --volume=/run/agentic-proxy \
  agentic-proxy
docker network \
  connect \
  agentic-net \
  agentic-proxy-<id>
docker run \
  --detach \
  --read-only \
  --name=agentic-docker-<id> \
  --network=agentic-run-<id> \
  --network-alias=agentic-docker \
  --label=project=agentic-cli \
  --pids-limit=256 \
  --cpus=1 \
  --memory=1g \
  --user=1000:1000 \
  --env=HOME=/home/rootless \
  --cap-drop=ALL \
  --label=agentic.owner=agentic-claude-<id> \
  --label=agentic.started=<time> \
  --cap-add=SYS_ADMIN \
  --cap-add=NET_ADMIN \
  --cap-add=SETUID \
  --cap-add=SETGID \
  --cap-add=SETFCAP \
  --cap-add=CHOWN \
  --cap-add=DAC_OVERRIDE \
  --cap-add=FOWNER \
  --cap-add=FSETID \
  --cap-add=MKNOD \
  --cap-add=SYS_CHROOT \
  --cap-add=SETPCAP \
  --cap-add=KILL \
  --cap-add=AUDIT_WRITE \
  --cap-add=NET_BIND_SERVICE \
  --cap-add=NET_RAW \
  --security-opt=seccomp=<tool-home>/dind/<id>/seccomp.json \
  --security-opt=apparmor=unconfined \
  --security-opt=systempaths=unconfined \
  --device=/dev/net/tun \
  --tmpfs=/run:rw,mode=1777 \
  --tmpfs=/tmp:rw,mode=1777 \
  --env=DOCKER_TLS_CERTDIR=/certs \
  --volume=<tool-home>/dind/<id>/server:/certs/server:ro \
  --volume=<tool-home>/dind/<id>/client:/certs/client:ro \
  --volume=<tool-home>/dind/<id>/etc/passwd:/etc/passwd:ro \
  --volume=<tool-home>/dind/<id>/etc/group:/etc/group:ro \
  --volume=<tool-home>/dind/<id>/etc/subuid:/etc/subuid:ro \
  --volume=<tool-home>/dind/<id>/etc/subgid:/etc/subgid:ro \
  --volume=<pwd>:/workspace \
  --env=HTTP_PROXY=http://agentic-proxy:3128 \
  --env=HTTPS_PROXY=http://agentic-proxy:3128 \
  --env=http_proxy=http://agentic-proxy:3128 \
  --env=https_proxy=http://agentic-proxy:3128 \
  --env=NO_PROXY=localhost,127.0.0.1 \
  --env=no_proxy=localhost,127.0.0.1 \
  --env=NODE_USE_ENV_PROXY=1 \
  agentic-dind \
  --data-root=/home/rootless/.local/share/docker/data
docker run \
  --rm \
  --read-only \
  --name=agentic-claude-<id> \
  --label=project=agentic-cli \
  --pids-limit=512 \
  --cpus=2 \
  --memory=2g \
  --network=agentic-run-<id> \
  --cap-drop=ALL \
  --security-opt=no-new-privileges:true \
  --user=1000:1000 \
  --env=TZ=Etc/UTC \
  --env=EXAMPLE=value \
  --env=HTTP_PROXY=http://agentic-proxy:3128 \
  --env=HTTPS_PROXY=http://agentic-proxy:3128 \
  --env=http_proxy=http://agentic-proxy:3128 \
  --env=https_proxy=http://agentic-proxy:3128 \
  --env=NO_PROXY=localhost,127.0.0.1,agentic-docker \
  --env=no_proxy=localhost,127.0.0.1,agentic-docker \
  --env=NODE_USE_ENV_PROXY=1 \
  '--env=AGENTIC_PROXY_CA=<proxy CA issued at start>' \
  --env=EXAMPLE_API_KEY=agentic-<id> \
  --env=EXAMPLE_TOKEN=agentic-<id> \
  '--env=GRADLE_OPTS=-Dhttp.proxyHost=agentic-proxy -Dhttp.proxyPort=3128 -Dhttps.proxyHost=agentic-proxy -Dhttps.proxyPort=3128' \
  '--env=MAVEN_ARGS=--global-settings /etc/agentic/maven/settings.xml' \
  --env=DOCKER_HOST=tcp://agentic-docker:2376 \
  --env=DOCKER_TLS_VERIFY=1 \
  --env=DOCKER_CERT_PATH=/run/secrets/docker \
  --env=DOCKER_CONFIG=/run/docker-config \
  --volume=<tool-home>/dind/<id>/client:/run/secrets/docker:ro \
  --volume=<tool-home>/dind/<id>/config:/run/docker-config \
  --volume=<pwd>:/workspace \
  agentic-claude \
  --example
